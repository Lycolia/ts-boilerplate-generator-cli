{
  "name": "@lycolia/ts-boilerplate-generator-cli",
  "version": "0.34.0",
  "description": "ts-server-boilerplate project Generator CLI",
  "keywords": [
    "typescript",
    "generator",
    "generate",
    "boilerplate",
    "project",
    "scaffolding",
    "linux",
    "node.js",
    "react",
    "next.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lycolia/ts-boilerplate-generator-cli"
  },
  "bin": {
    "tsg": "dist/index.js"
  },
  "scripts": {
    "start": "pnpm build-ts && node dist/index.js",
    "dev": "pnpm build-ts && node --inspect-brk dist/index.js",
    "fix": "biome format --write src/ && prettier --write *.md",
    "lint": "tsc --noEmit && biome lint src/",
    "build-ts": "rm -Rf dist/ && swc src/ --config-file .swcrc_build -d dist/ --strip-leading-paths",
    "build": "pnpm lint && pnpm build-ts",
    "test": "jest --watch",
    "headless-test": "jest --colors",
    "coverage": "jest --coverage",
    "postinstall": "git config core.hooksPath .git-hooks"
  },
  "author": "Lycolia",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "prompts": "^2.4.2",
    "validate-npm-package-name": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.32",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "@types/validate-npm-package-name": "^4.0.2",
    "jest": "^30.3.0",
    "jest-watch-typeahead": "^3.0.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
